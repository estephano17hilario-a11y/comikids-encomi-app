<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header: Logo, Title & Status Dot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦"
            android:textSize="18sp"
            android:layout_marginEnd="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENCOMI • COMIKIDS"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_title_orders_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Despachos Activos"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Sync Pill -->
        <TextView
            android:id="@+id/widget_badge_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="● EN VIVO"
            android:textColor="#34D399"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Metrics Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:weightSum="3">

        <!-- En Almacen -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1E293B"
            android:padding="5dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:id="@+id/widget_count_almacen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Almacén"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Alistando -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1E293B"
            android:padding="5dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:id="@+id/widget_count_alistando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#C084FC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alistando"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- En Ruta -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1E293B"
            android:padding="5dp">

            <TextView
                android:id="@+id/widget_count_ruta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En Ruta"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Lista COMPLETA de Pedidos usando ListView (RemoteViewsService) -->
    <ListView
        android:id="@+id/widget_orders_stack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="✨ No hay pedidos pendientes por despachar"
        android:textColor="#94A3B8"
        android:textSize="9.5sp"
        android:visibility="gone" />

    <!-- Bottom Quick Action Info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="Toca para abrir Encomi Gestor 🚀"
        android:textColor="#64748B"
        android:textSize="8.5sp"
        android:textStyle="bold" />

</LinearLayout>
